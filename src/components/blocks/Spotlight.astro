---
import Inline from '../Inline.astro';
import Paras from '../Paras.astro';
import Art from '../Art.astro';
const { block: b, palette } = Astro.props;
---
<h3 class="spot-name display">{b.name}</h3>
<p class="spot-what"><Inline text={b.what} /></p>
{b.background && <p class="context"><b>Context</b><Inline text={b.background} /></p>}
<p class="gist"><Inline text={b.gist} /></p>
{(b.image || b.art) && <Art src={b.art} alt={b.artAlt} image={b.image} ink={b.ink} />}
<Paras items={b.body} />
{b.facts.length > 0 && (
  <dl class="facts">
    {b.facts.map((f) => <div><dt>{f.k}</dt><dd><Inline text={f.v} /></dd></div>)}
  </dl>
)}
{b.tryIt && <p class="try"><span>Try it</span><code>{b.tryIt}</code></p>}
