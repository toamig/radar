---
import Inline from '../Inline.astro';
import Paras from '../Paras.astro';
import Art from '../Art.astro';
import DiagramFigure from '../DiagramFigure.astro';
const { block: b } = Astro.props;
const title = b.title;
const visual = b.image || b.art ? 'art' : b.diagram ? 'diagram' : 'none';
---
<div class:list={['hero-wrap', `hero-visual-${visual}`]}>
  {visual === 'art' && b.variant !== 'split' && <Art class="hero-art" src={b.art} alt={b.artAlt} image={b.image} ink={b.ink} eager />}
  <div class="hero-head">
    <h2 class="hero-title display overprint register" data-text={title}>{title}</h2>
    <p class="hero-take"><Inline text={b.gist ?? b.takeaway} /></p>
    {b.background && <p class="context"><b>Context</b><Inline text={b.background} /></p>}
  </div>
  {visual === 'diagram' && <DiagramFigure class:list={['hero-dia', { 'hero-dia-wide': b.variant !== 'split' }]} id={b.id} title={b.title} {...b.diagram} />}
  {visual === 'art' && b.variant === 'split' && <Art class="hero-art" src={b.art} alt={b.artAlt} image={b.image} ink={b.ink} eager />}
  <div class="hero-text">
    <Paras items={b.body} class="b-body hero-cols" />
    {b.stat && <p class="hero-stat"><span class="n display">{b.stat.value}</span><span class="l">{b.stat.label}</span></p>}
  </div>
</div>
