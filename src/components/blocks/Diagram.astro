---
// The diagram block: an intro line and a kit-drawn schematic (see DiagramFigure).
import Inline from '../Inline.astro';
import DiagramFigure from '../DiagramFigure.astro';
const { block: b } = Astro.props;
---
<p class="b-lead"><Inline text={b.intro} /></p>
<DiagramFigure id={b.id} title={b.title} layout={b.layout} nodes={b.nodes} links={b.links} caption={b.caption} />
