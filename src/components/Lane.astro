---
import { laneName } from '../kit/site';
interface Props { lane: 'gamedev' | 'ai' | 'both'; label?: boolean }
const { lane, label = true } = Astro.props;
---
<span class="lane" title={laneName(lane)}>
  <svg viewBox="0 0 14 14" aria-hidden="true">
    {lane === 'gamedev' && <path d="M5 0h4v5h5v4H9v5H5V9H0V5h5z" />}
    {lane === 'ai' && <path d="M7 0l1.9 5.1L14 7l-5.1 1.9L7 14l-1.9-5.1L0 7l5.1-1.9z" />}
    {lane === 'both' && <><path d="M3 0h3v3h3v3H6v3H3V6H0V3h3z" /><path d="M10.5 6l1 2.5 2.5 1-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1z" /></>}
  </svg>
  {label ? laneName(lane) : <span class="sr-only">{laneName(lane)}</span>}
</span>
