---
// Jump links to the issue's sections and the week (Learn covers Learn one thing and Try this). A sticky bar under the
// masthead on wide screens, a bottom tab bar within thumb reach on phones. The
// link for the section in view is marked as current while scrolling.
interface Props { stories: number; learn?: number; learnHref?: string; sparks: number; lab: number; days: number }
const { stories, learn = 0, learnHref = '#learn', sparks, lab, days } = Astro.props;
const links = [
  { href: '#stories', label: 'Stories', count: stories, icon: 'M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z' },
  { href: learnHref, label: 'Learn', count: learn, icon: 'M2 3.5C4 2.5 6 2.5 8 4c2-1.5 4-1.5 6-.5V13c-2-1-4-1-6 .5-2-1.5-4-1.5-6-.5zM8 4v9.5' },
  { href: '#sparks', label: 'Sparks', count: sparks, icon: 'M8 1l1.8 4.6L14.5 7l-4.7 1.4L8 13l-1.8-4.6L1.5 7l4.7-1.4z' },
  { href: '#lab', label: 'The lab', count: lab, icon: 'M6 1h4v1H9v4l4.5 7.5c.4.7-.1 1.5-.9 1.5H3.4c-.8 0-1.3-.8-.9-1.5L7 6V2H6z' },
  { href: '#week', label: 'This week', count: days, icon: 'M2 3h12v11H2zM2 6h12M5 1v3M11 1v3' },
].filter((l) => l.count > 0);
---
<nav class="secnav" aria-label="Sections">
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d={l.icon} /></svg>
          <span class="secnav-label">{l.label}</span>
          <span class="secnav-count" aria-label={`${l.count} items`}>{l.count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
<script>
  // The current section is the last one whose top has passed 40% of the viewport.
  const nav = document.querySelector<HTMLElement>('.secnav');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.getElementById(a.hash.slice(1)));
    let queued = false;
    const mark = () => {
      queued = false;
      const line = window.innerHeight * 0.4;
      let current = -1;
      targets.forEach((el, i) => { if (el && el.getBoundingClientRect().top <= line) current = i; });
      links.forEach((a, i) => (i === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      nav.classList.toggle('stuck', nav.getBoundingClientRect().top <= 0);
    };
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
    mark();
  }
</script>
