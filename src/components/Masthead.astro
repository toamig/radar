---
import ToaMark from './ToaMark.astro';
import { BASE, formatDate } from '../kit/data';
interface Props { date: string; number: number; sub?: string }
const { date, number, sub } = Astro.props;
---
<header class="mast">
  <p class="mast-brand">
    <a href={BASE} aria-label="Toa Radar, latest issue">
      <ToaMark class="mast-mark" />
      <span class="mast-word display overprint register" data-text="Radar" aria-hidden="true">Radar</span>
    </a>
  </p>
  <div class="mast-meta">
    <span class="mast-no">No. {number}</span>
    <span class="mast-date">{formatDate(date)}</span>
    <span class="mast-sub">{sub ?? 'Game dev, software and AI'}</span>
  </div>
</header>
