---
// The visual slot of a block: a real image, or a labelled schematic drawn as SVG.
// There is no decorative fallback: a block with nothing worth showing shows nothing.
import Media from './Media.astro';
import { asset } from '../kit/data';
interface Props { src?: string; alt?: string; image?: any; ink?: 'a' | 'b'; class?: string; eager?: boolean; [k: string]: any }
const { src, alt, image, ink = 'a', eager } = Astro.props;
const cls = Astro.props.class ?? 'art';
---
{image
  ? <Media image={image} ink={ink} class={cls} eager={eager} />
  : src && <figure class={cls}><img src={asset(src)} alt={alt ?? ''} loading="lazy" decoding="async" /></figure>}
