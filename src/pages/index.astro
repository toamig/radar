---
import IssueView from '../components/IssueView.astro';
import Base from '../layouts/Base.astro';
import { latest } from '../kit/data';
import { SAFE_THEME } from '../kit/catalog.mjs';
---
{latest
  ? <IssueView issue={latest} path="" />
  : <Base title="Radar" description="A daily briefing on game development and AI engineering." theme={SAFE_THEME}>
      <p style="padding:20vh 0">The first issue is being printed. Check back after the morning run.</p>
    </Base>}
