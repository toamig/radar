---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/radar.css';
import '../styles/kit-extras.css';
import '../styles/sparks.css';
import '../styles/nav.css';
import '../styles/readability.css';
import { resolveTheme, onInk } from '../kit/catalog.mjs';
import { BASE } from '../kit/data';
import { toaSvg } from '../kit/toa-mark.mjs';

interface Props {
  title: string;
  description: string;
  theme: Record<string, unknown>;
  path?: string;
  /** The headline people see when the link is shared; defaults to the page title. */
  shareTitle?: string;
  /** Share card under public/, made by scripts/og.mjs. */
  ogImage?: string;
  ogImageAlt?: string;
}
const { title, description, theme, path = '', shareTitle = title, ogImage, ogImageAlt } = Astro.props;
const t = resolveTheme(theme);
const vars = (s: typeof t.day) => `
  --paper:${s.paper};--text:${s.text};--muted:${s.muted};--rule:${s.rule};
  --ink-a:${s.inkA};--ink-b:${s.inkB};--display-a:${s.displayA};--display-b:${s.displayB};
  --tint-a:${s.tintA};--tint-b:${s.tintB};--on-a:${onInk(s.inkA)};--on-b:${onInk(s.inkB)};`;
const typeVars = `--display-font:${t.type.display};--display-weight:${t.type.displayWeight};
  --display-stretch:${t.type.displayStretch};--display-tracking:${t.type.tracking};
  --display-case:${t.type.caseUpper ? 'uppercase' : 'none'};--plate:${t.plate};
  --display-scale:${t.type.scale};`;
// Values come from the catalog tables, never from issue text.
const css = `:root{${vars(t.day)}${typeVars}}
@media (prefers-color-scheme: dark){:root:not([data-theme='light']){${vars(t.night)}}}
:root[data-theme='dark']{${vars(t.night)}}`;
const canonical = new URL(`${BASE}${path}`, Astro.site).href;
// The tab icon is the TOA mark in this issue's two inks, so it changes with the palette.
const favicon = `data:image/svg+xml,${encodeURIComponent(toaSvg(t.day.inkB, t.day.inkA, { square: true }))}`;
const ogImageUrl = ogImage ? new URL(`${BASE}${ogImage}`, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Toa Radar by Toamig" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {ogImageUrl && <>
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={ogImageAlt ?? shareTitle} />
    </>}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="theme-color" content={t.day.paper} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="alternate icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <style set:html={css}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var q = new URLSearchParams(location.search);
        if (q.has('tune')) localStorage.setItem('radar-tune', q.get('tune') === '0' ? '0' : '1');
        if (localStorage.getItem('radar-tune') === '1') document.documentElement.classList.add('tuning');
        if (localStorage.getItem('radar-key') !== '1') document.documentElement.classList.add('new-reader');
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
    <a class="tune-flag" href="?tune=0">Tune mode is on in this browser. <u>Turn it off</u></a>
    <script>
      import '../kit/terms-client';
      // Charts draw their bars when they scroll into view.
      const charts = document.querySelectorAll('.chart');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { threshold: 0.3 });
        charts.forEach((c) => io.observe(c));
      } else charts.forEach((c) => c.classList.add('in'));

      // Videos load only when asked, from the no-cookie domain.
      document.querySelectorAll<HTMLButtonElement>('.vid button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const box = btn.parentElement!;
          const f = document.createElement('iframe');
          f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.id}?autoplay=1`;
          f.allow = 'autoplay; encrypted-media; picture-in-picture';
          f.allowFullscreen = true;
          f.title = box.dataset.title ?? 'Video';
          box.replaceChildren(f);
        });
      });
    </script>
  </body>
</html>
